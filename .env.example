# ==========================================
# SUPABASE (Base de Datos, Auth y Storage)
# ==========================================
# URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anónima (anon / public key) de tu proyecto en Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==========================================
# RESEND (Envío de Correos desde /contacto)
# ==========================================
# Clave de API de Resend (empieza con re_...)
RESEND_API_KEY=

# Tu correo personal donde recibirás los mensajes del formulario de contacto
CONTACT_RECEIVER_EMAIL=

# (Opcional) Remitente verificado en Resend. Si se omite se usa "Sitio Personal <onboarding@resend.dev>"
# CONTACT_FROM_EMAIL=
